# Maintainer: iMacnucintosh
# The command line of the Sylphrena shell (`sylph`), built from the git repository.
#   cd packaging && makepkg -si
pkgname=sylphrena-cli-git
pkgver=0.0.0.r0.g0000000
pkgrel=1
pkgdesc="Command line of the Sylphrena shell (sylph): shell, themes, wallpapers, screenshots, extensions"
arch=('any')
url="https://github.com/iMacnucintosh/sylphrena-cli"
license=('GPL-3.0-only')
depends=('python' 'python-pillow' 'python-materialyoucolor')
makedepends=('git' 'python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs')
optdepends=('wl-clipboard: copy screenshots and colours'
            'grim: screenshots' 'slurp: select a region' 'gpu-screen-recorder: screen recording (sylph record)'
            'swappy: edit screenshots' 'libnotify: notifications')
provides=('sylphrena-cli')
conflicts=('sylphrena-cli')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd sylphrena-cli
  local described
  if described="$(git describe --tags --long --match 'v0.*' 2>/dev/null)"; then
    printf '%s' "$described" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd sylphrena-cli
  # hatch-vcs reads the version from git: the nearest tag of ours
  export SETUPTOOLS_SCM_PRETEND_VERSION="${pkgver%%.r*}"
  python -m build --wheel --no-isolation
}

package() {
  cd sylphrena-cli
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 completions/sylph.fish "$pkgdir/usr/share/fish/vendor_completions.d/sylph.fish"
}
